        <!-- Arrow NestJS -> Database -->
        <mxCell id="edge-db" value="Data Access" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=12;fontStyle=1;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="backend" target="database">
          <mxGeometry relative="1" as="geometry" />
